#!/bin/sh
set -eu

usage() {
	cat <<'EOF'
usage: ports [-p PORT] [-a]

Show listening sockets with the process holding each port.

  -p PORT   only rows for this port
  -a        include non-listening (all) sockets
  -h        show this help

Uses ss when present, otherwise netstat or lsof. Sockets owned by other
users show as "-" because reading their process needs privilege.
EOF
}

want_port=""
all=0

while getopts ':p:ah' opt; do
	case $opt in
	p) want_port=$OPTARG ;;
	a) all=1 ;;
	h) usage; exit 0 ;;
	*) usage >&2; exit 2 ;;
	esac
done
shift $((OPTIND - 1))

if [ -n "$want_port" ]; then
	case $want_port in
	'' | *[!0-9]*)
		printf 'ports: -p wants a port number, got: %s\n' "$want_port" >&2
		exit 2
		;;
	esac
fi

state_filter=''
[ "$all" -eq 1 ] || state_filter='-t state listening'

collect() {
	if command -v ss >/dev/null 2>&1; then
		# shellcheck disable=SC2086
		ss -H -n -tulpn $state_filter 2>/dev/null && return 0
	fi
	if command -v netstat >/dev/null 2>&1; then
		netstat -tulpn 2>/dev/null && return 0
	fi
	if command -v lsof >/dev/null 2>&1; then
		lsof -nP -i -sTCP:LISTEN 2>/dev/null && return 0
	fi
	return 1
}

rows=$(collect) || {
	printf 'ports: need one of ss, netstat or lsof\n' >&2
	exit 1
}

[ -n "$rows" ] || exit 0

printf '%s\n' "$rows" | awk -v want="$want_port" '
function cleanproc(s) {
	sub(/^.*\(/, "", s)
	sub(/\).*$/, "", s)
	gsub(/["\047]/, "", s)
	sub(/,.*$/, "", s)
	return s
}

{
	proto = tolower($1)
	sub(/[0-9]+$/, "", proto)
	if (proto != "tcp" && proto != "udp") next

	# the process column is only present as users:((...)); anything else in the
	# last column is the peer address, which is not what we want to print
	last = $NF
	proc = "-"
	if (last ~ /users:\(\(/ || last ~ /^[0-9]+\//) {
		proc = cleanproc(last)
		if (proc == "") proc = "-"
	}

	# local address is the first column ending in :digits
	local = ""
	for (i = 1; i <= NF; i++) {
		if ($i ~ /:[0-9]+$/) { local = $i; break }
	}
	if (local == "") next

	port = local
	sub(/^.*:/, "", port)
	if (want != "" && port != want) next

	printf "%5s  %-3s  %-22s  %s\n", port, proto, local, proc
}
' | sort -n -k1 -k3 | uniq

exit 0